{
  "name": "Discord Claude Bot",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Discord Trigger",
      "type": "n8n-nodes-base.discordTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": {
        "discordBotApi": {
          "id": "",
          "name": "Discord Bot Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.author.bot }}",
              "value2": true,
              "operation": "notEqual"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Not a Bot",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://claude-api:3400/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.content }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 280]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.response || 'Sorry, I could not generate a response.';\n\n// Discord has a 2000 character limit\nconst truncated = response.length > 1900\n  ? response.substring(0, 1900) + '...'\n  : response;\n\nreturn [{\n  json: {\n    content: truncated,\n    channelId: $('Not a Bot').first().json.channel_id\n  }\n}];"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 280]
    },
    {
      "parameters": {
        "resource": "channel",
        "operation": "sendMessage",
        "channelId": "={{ $json.channelId }}",
        "content": "={{ $json.content }}"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Discord Reply",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1120, 280],
      "credentials": {
        "discordBotApi": {
          "id": "",
          "name": "Discord Bot Token"
        }
      }
    }
  ],
  "connections": {
    "Discord Trigger": {
      "main": [
        [
          {
            "node": "Not a Bot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Not a Bot": {
      "main": [
        [
          {
            "node": "Ask Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Claude": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Discord Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
